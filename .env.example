# Nova LiveOS installer environment — copy to .env and fill in. NEVER commit .env.
# Create a FRESH Supabase account/project for LiveOS — do not reuse another
# product's project. Get these from: Supabase dashboard → your project →
# Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Optional: personal access token for `supabase link` (dashboard → Account → Access Tokens)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
# Cloudflare Pages project name for the shell deploy
CLOUDFLARE_PAGES_PROJECT=nova-liveos
